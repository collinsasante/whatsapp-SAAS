{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@whatsapp-platform/api": [
        "../../packages/api/src"
      ],
      "@whatsapp-platform/auth": [
        "../../packages/auth/src"
      ],
      "@whatsapp-platform/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@whatsapp-platform/socket": [
        "../../packages/socket/src"
      ],
      "@whatsapp-platform/theme": [
        "../../packages/theme/src"
      ],
      "@whatsapp-platform/validation": [
        "../../packages/validation/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
