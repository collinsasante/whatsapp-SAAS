// ---- Verz-AI Phase 1: foundation (provider abstraction, agents, versioned
// prompts, execution tracing). Built strangler-style alongside AiInteractionLog
// and the legacy responder -- see ai-core/ module. AiInteractionLog stays the
// human-workflow record (suggested/approved/edited/feedback); AiExecution below
// is the machine trace, linked loosely via interactionLogId. ----

model AiAgent {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  description         String?
  avatarUrl           String?  @map("avatar_url")
  status              String   @default("ACTIVE") // ACTIVE | PAUSED
  isDefault           Boolean  @default(false) @map("is_default")
  // The synthetic isAiAgent User row this agent uses for inbox identity
  // (Conversation.assignedToId / Message.senderId) -- see findOrCreateVerzAgent.
  agentUserId         String?  @unique @map("agent_user_id")
  systemInstructions  String?  @map("system_instructions") @db.Text
  personality         String?
  tone                String?
  language            String   @default("en")
  modelKey            String   @default("deepseek-v4-flash") @map("model_key")
  maxResponseTokens   Int      @default(400) @map("max_response_tokens")
  confidenceThreshold Int?     @map("confidence_threshold")
  // ---- Phase 2+ stubs: typed slots, unread in Phase 1, never presented as functional ----
  allowedTools        Json?    @map("allowed_tools")
  knowledgeSourceIds  String[] @map("knowledge_source_ids")
  assignedNumberIds   String[] @map("assigned_number_ids")
  workingHours        Json?    @map("working_hours")
  escalationRules     Json?    @map("escalation_rules")
  handoffSettings     Json?    @map("handoff_settings")
  memorySettings      Json?    @map("memory_settings")
  safetyRules         Json?    @map("safety_rules")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentUser  User?         @relation("AiAgentUser", fields: [agentUserId], references: [id], onDelete: SetNull)
  executions AiExecution[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("ai_agents")
}

model AiPromptTemplate {
  id          String            @id @default(uuid())
  key         String            @unique // e.g. 'responder.system'
  name        String
  description String?
