model AiExecution {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  agentId          String?  @map("agent_id")
  conversationId   String?  @map("conversation_id")
  // Loose link to AiInteractionLog (matches that model's own loose-FK style),
  // written post-hoc after the log row is created in the orchestration block.
  interactionLogId String?  @map("interaction_log_id")
  promptVersionId  String?  @map("prompt_version_id")
  taskType         String   @map("task_type") // RESPONDER | SUMMARIZE | KB_LEARN | TEST | LEAD_SCORE
  provider         String
  modelKey         String   @map("model_key")
  status           String   // SUCCESS | BLOCKED | POLICY_REJECTED | PROVIDER_ERROR | EMPTY
  latencyMs        Int?     @map("latency_ms")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  estCostUsd       Decimal? @map("est_cost_usd") @db.Decimal(10, 6)
  confidence       Float?
  safetyFlags      Json?    @map("safety_flags") // {injectionDetected, fallbackCapped, emptyOutput}
  errorCode        String?  @map("error_code")
  errorMessage     String?  @map("error_message")
  stageTimings     Json?    @map("stage_timings") // {guard: 1, context: 42, generate: 1830, ...}
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         AiAgent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  promptVersion AiPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  creditTransaction AiCreditTransaction?

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("ai_executions")
}

// ── Admin platform: error monitoring & webhook monitoring ──────────────────
// Both approved as genuinely new infrastructure -- neither existed anywhere
// in the codebase before this. Both only ever start collecting data from
// when they ship; no historical backfill is possible or attempted.

// One row per distinct error fingerprint (service+message), with a running
// occurrence count -- not one row per occurrence, to avoid an unbounded
// table under a real incident. Written from SentryExceptionFilter (5xx) and
// ClientErrorsController (frontend reports); both already the single
// catch-all point for their respective error source.
model ErrorLog {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  service          String    // 'backend' | 'frontend' | a specific module name
  severity         String    @default("ERROR") // WARN | ERROR | CRITICAL
  message          String    @db.Text
  stack            String?   @db.Text
  requestId        String?   @map("request_id")
  resourceType     String?   @map("resource_type")
  resourceId       String?   @map("resource_id")
  fingerprint      String    // dedup key: service+message-prefix(+url/status where available)
  occurrenceCount  Int       @default(1) @map("occurrence_count")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  status           String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([tenantId])
  @@index([severity, status])
  @@index([lastSeenAt])
  @@map("error_logs")
}

enum WebhookSource {
  WHATSAPP
  STRIPE_BILLING
  PAYSTACK_BILLING
  PAYSTACK_COMMERCE
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// One row per inbound webhook delivery across all four sources -- something
// none of the existing webhook controllers persisted before (each only
// logged independently via Logger/notify()). `payload` is captured with
// secrets/signatures stripped before persistence, never raw. `attempts`
// only increments on an admin-triggered reprocess (POST .../reprocess),
// which is only offered for sources whose underlying handler is already
// proven idempotent (all four are, by construction of their own dedup keys).
model WebhookEvent {
  id             String              @id @default(uuid())
  source         WebhookSource
  eventType      String              @map("event_type")
  status         WebhookEventStatus  @default(RECEIVED)
  gatewayEventId String?             @map("gateway_event_id")
  tenantId       String?             @map("tenant_id")
  payload        Json?
  error          String?             @db.Text
  attempts       Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  processedAt    DateTime?           @map("processed_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([source, status])
  @@index([tenantId])
  @@index([createdAt])
  @@index([gatewayEventId])
  @@map("webhook_events")
}

// ── Verz AI Credits billing ─────────────────────────────────────────────────

enum AiCreditTransactionType {
  PURCHASE
  BONUS
  AI_USAGE
  REFUND
  ADJUSTMENT
}

// Append-only ledger -- Tenant.aiCredits is the fast-read cached balance,
// this is the source of truth for how it got there. aiExecutionId/
// creditPurchaseId are each @unique (Postgres allows multiple NULLs on a
// unique column, so non-AI_USAGE/non-PURCHASE rows are unaffected) --
// exactly one settlement per AI call, exactly one grant per purchase,
// enforced by the database, same pattern as CommerceLedgerEntry's
// @@unique([orderId, type, gatewayEventId]).
model AiCreditTransaction {
  id               String                  @id @default(uuid())
  tenantId         String                  @map("tenant_id")
  type             AiCreditTransactionType
  credits          Int // negative for AI_USAGE / negative ADJUSTMENT, positive otherwise
  balanceAfter     Int                     @map("balance_after")
  aiExecutionId    String?                 @unique @map("ai_execution_id")
  creditPurchaseId String?                 @unique @map("credit_purchase_id")
  description      String
  metadata         Json?
  createdAt        DateTime                @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiExecution    AiExecution?    @relation(fields: [aiExecutionId], references: [id], onDelete: SetNull)
  creditPurchase CreditPurchase? @relation(fields: [creditPurchaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ai_credit_transactions")
}

// Admin-configurable AI provider/model pricing -- the only place cost-per-
// token and the credit conversion multiplier live. model-catalog.ts stays
// the source of truth for provider capabilities (context window, tool
// support); pricing specifically is DB-backed so it can change without a
// deploy.
model AiPricingConfig {
  id                      String   @id @default(uuid())
  provider                String
  modelKey                String   @map("model_key")
  inputCostPerMillionUsd  Float    @map("input_cost_per_million_usd")
  outputCostPerMillionUsd Float    @map("output_cost_per_million_usd")
  creditsPerUsd           Float    @map("credits_per_usd")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([provider, modelKey])
  @@map("ai_pricing_configs")
}

// Admin-configurable credit packages -- replaces BillingService's previous
// hardcoded CREDIT_PACKS array. credits is gateway-agnostic (same grant
// regardless of which gateway you paid through); priceGhs backs the
// Paystack checkout, priceUsd backs Stripe.
model AiCreditPackage {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  credits      Int
  bonusCredits Int      @default(0) @map("bonus_credits")
  priceGhs     Float?   @map("price_ghs")
  priceUsd     Float?   @map("price_usd")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_credit_packages")
}
