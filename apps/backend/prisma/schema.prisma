  adminId      String?        @map("admin_id")
  action       String
  resourceType String?        @map("resource_type")
  resourceId   String?        @map("resource_id")
  metadata     Json?
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  createdAt    DateTime       @default(now()) @map("created_at")

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model PlatformSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentGateway {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Plan {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  monthlyPrice Float  @map("monthly_price")
  yearlyPrice  Float  @map("yearly_price")
  currency     String @default("USD")
  ghsMonthlyPrice Float? @map("ghs_monthly_price")
  ghsYearlyPrice  Float? @map("ghs_yearly_price")
  isActive     Boolean @default(true) @map("is_active")
  isPublic     Boolean @default(true) @map("is_public")
  trialDays    Int     @default(0)    @map("trial_days")

  limMaxAgents         Int @default(1)    @map("lim_max_agents")
  limMaxChannels       Int @default(1)    @map("lim_max_channels")
  limMaxContacts       Int @default(500)  @map("lim_max_contacts")
  limMaxTemplates      Int @default(5)    @map("lim_max_templates")
  limMessagesPerMonth  Int @default(1000) @map("lim_messages_per_month")
  limMaxCampaigns      Int @default(0)    @map("lim_max_campaigns")
  limAiCreditsPerMonth Int @default(0)    @map("lim_ai_credits_per_month")
  limStorageGb         Int @default(1)    @map("lim_storage_gb")

  features  Json @default("[]")
  metadata  Json?
  sortOrder Int  @default(0) @map("sort_order")

  stripePriceIdMonthly   String? @unique @map("stripe_price_id_monthly")
  stripePriceIdYearly    String? @unique @map("stripe_price_id_yearly")
  paystackPlanCodeMonthly String? @unique @map("paystack_plan_code_monthly")
  paystackPlanCodeYearly  String? @unique @map("paystack_plan_code_yearly")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  subscriptions Subscription[]

  @@map("billing_plans")
}

model Subscription {
  id       String             @id @default(uuid())
  tenantId String             @unique @map("tenant_id")
  planId   String             @map("plan_id")
  status   SubscriptionStatus @default(TRIAL)
  cycle    BillingCycle       @default(MONTHLY)

  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")

  stripeSubscriptionId      String? @unique @map("stripe_subscription_id")
  paystackSubscriptionCode  String? @unique @map("paystack_subscription_code")
  gatewayCustomerId         String? @map("gateway_customer_id")

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)

  subtotal Float
  tax      Float @default(0)
  discount Float @default(0)
  total    Float
  currency String @default("USD")

  billingPeriodStart DateTime  @map("billing_period_start")
  billingPeriodEnd   DateTime  @map("billing_period_end")
  dueDate            DateTime  @map("due_date")
  paidAt             DateTime? @map("paid_at")

  billingEmail String? @map("billing_email")
  billingName  String? @map("billing_name")

  gateway           PaymentGateway? @map("gateway")
  gatewayInvoiceId  String?         @map("gateway_invoice_id")
  gatewayPaymentUrl String?         @map("gateway_payment_url")

  notes     String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(uuid())
  invoiceId   String @map("invoice_id")
  description String
  quantity    Int    @default(1)
  unitPrice   Float  @map("unit_price")
  amount      Float
  metadata    Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  invoiceId String?        @map("invoice_id")
  gateway   PaymentGateway
  status    PaymentStatus  @default(PENDING)

  amount   Float
  currency String @default("USD")

  gatewayPaymentId   String? @unique @map("gateway_payment_id")
  gatewayReference   String? @map("gateway_reference")
  gatewayWebhookData Json?   @map("gateway_webhook_data")

  verifiedAt DateTime? @map("verified_at")
  failReason String?   @map("fail_reason")

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([gateway])
  @@index([tenantId, createdAt])
  @@index([tenantId, verifiedAt])
  @@map("payments")
}

// ─── Analytics daily rollups ──────────────────────────────────────────────
// Populated by a scheduled worker job (one row per tenant per calendar day,
// bucketed in the tenant's configured timezone) so the analytics endpoints
// never scan the live messages/conversations/payments tables for anything
// but the current (still-open) day. Count-based metrics only -- medians
// (first response time, resolution time) don't combine additively across
// day buckets, so those are computed via a live indexed query instead.

model AnalyticsDailyMessageStats {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  date     DateTime @db.Date

  sentCount      Int @default(0) @map("sent_count")
  deliveredCount Int @default(0) @map("delivered_count")
  readCount      Int @default(0) @map("read_count")
  failedCount    Int @default(0) @map("failed_count")
  inboundCount   Int @default(0) @map("inbound_count")
  outboundCount  Int @default(0) @map("outbound_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("analytics_daily_message_stats")
}

model AnalyticsDailyConversationStats {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  date     DateTime @db.Date

  newConversations       Int @default(0) @map("new_conversations")
  returningConversations Int @default(0) @map("returning_conversations")
  openedCount            Int @default(0) @map("opened_count")
  resolvedCount          Int @default(0) @map("resolved_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("analytics_daily_conversation_stats")
}

model AnalyticsDailyRevenueStats {
  id       String         @id @default(uuid())
  tenantId String         @map("tenant_id")
  date     DateTime       @db.Date
  gateway  PaymentGateway

  successCount  Int   @default(0) @map("success_count")
  failedCount   Int   @default(0) @map("failed_count")
  amount        Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, gateway])
  @@index([tenantId, date])
  @@map("analytics_daily_revenue_stats")
}

// ─── Platform admin: cross-tenant rollups ─────────────────────────────────
// Platform-wide message/conversation/revenue totals and provider success
// rates are NOT duplicated here -- they're derived live by aggregating the
// existing tenant-scoped AnalyticsDaily*Stats tables above across all
// tenants (see the `date` indexes added on those tables in this migration).
// What genuinely can't be derived from existing tables lives here:
// per-tenant-per-day MRR snapshots (for movement classification + tenant
// drill-down), platform-wide tenant/subscription lifecycle counts, and a
// daily FX rate so multi-currency revenue can be normalized to one
// reporting currency (GHS) with the estimation clearly flagged.

model CurrencyRate {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  currency    String
  rateToGhs   Float    @map("rate_to_ghs")
  isEstimated Boolean  @default(true) @map("is_estimated")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([date, currency])
  @@map("currency_rates")
}

enum MrrMovementCategory {
  NEW
  EXPANSION
  CONTRACTION
  CHURNED
  RETAINED
  NONE
}

// One row per tenant per calendar day -- the MRR the tenant contributed that day, normalized to GHS, and how it moved vs. the prior day's row.
model PlatformTenantMrrSnapshot {
  id       String              @id @default(uuid())
  tenantId String              @map("tenant_id")
  date     DateTime            @db.Date
  mrrGhs   Float               @default(0) @map("mrr_ghs")
  category MrrMovementCategory

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([date, category])
  @@map("platform_tenant_mrr_snapshots")
}

// One row per calendar day -- platform-wide tenant/subscription lifecycle counts, MRR/ARR totals, and login-derived DAU/WAU/MAU.
model PlatformDailyStats {
  id   String   @id @default(uuid())
  date DateTime @unique @db.Date

  totalTenants         Int @default(0) @map("total_tenants")
  activeTenants        Int @default(0) @map("active_tenants")
  newTenants           Int @default(0) @map("new_tenants")
  trialTenants         Int @default(0) @map("trial_tenants")
  activeSubscriptions  Int @default(0) @map("active_subscriptions")
  pastDueSubscriptions Int @default(0) @map("past_due_subscriptions")
  trialsConverted      Int @default(0) @map("trials_converted")
  churnedTenants       Int @default(0) @map("churned_tenants")

  mrrGhs Float @default(0) @map("mrr_ghs")
  arrGhs Float @default(0) @map("arr_ghs")

  dau Int @default(0)
  wau Int @default(0)
  mau Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("platform_daily_stats")
}

model WorkspaceUsage {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  messagesSent        Int   @default(0)   @map("messages_sent")
  messagesReceived    Int   @default(0)   @map("messages_received")
  conversationsOpened Int   @default(0)   @map("conversations_opened")
  campaignsSent       Int   @default(0)   @map("campaigns_sent")
  aiCreditsUsed       Int   @default(0)   @map("ai_credits_used")
  activeAgents        Int   @default(0)   @map("active_agents")
  activeChannels      Int   @default(0)   @map("active_channels")
  storageUsedMb       Float @default(0)   @map("storage_used_mb")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId])
  @@map("workspace_usage")
}

model BillingEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  event          String
  gateway        PaymentGateway? @map("gateway")
  gatewayEventId String?         @map("gateway_event_id")

  data      Json
  processed Boolean  @default(false)
  error     String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event])
  @@index([processed])
  @@map("billing_events")
}

// ─── Managed Commerce (Phase 1, single-pilot-tenant) ──────────────────────
// Outcome-based GMV take-rate commerce, gated per tenant via
// TenantSettings.commerceEnabled. See implementation plan for full scope
// and what is deliberately deferred (KYC, multi-merchant console, disputes,
// statements UI, etc.) until this pilot proves the model.

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  sku           String?
  priceMajorUnits Float  @map("price_major_units")
  currency      String   @default("GHS")
  isActive      Boolean  @default(true) @map("is_active")
  imageUrl      String?  @map("image_url")
  stockQuantity Int?     @map("stock_quantity")
  // Verz-AI Phase 2b: below this quantity, an order routes to AWAITING_APPROVAL instead
  // of straight to checkout. Nullable, no default -- no minimum unless a tenant sets one.
  minOrderQuantity Int?  @map("min_order_quantity")
  // Simple JSON variants for Phase 1 (single pilot tenant) rather than a
  // relational ProductVariant table -- e.g. [{name, priceDeltaMajorUnits, stockQuantity, sku}].
  // A real join table is a fast-follow once there's more than one pilot merchant.
  variants      Json?
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("commerce_products")
}

enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL
  PENDING_PAYMENT
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  contactId      String      @map("contact_id")
  conversationId String?     @map("conversation_id")
  status         OrderStatus @default(DRAFT)
  currency       String      @default("GHS")
  subtotalMajorUnits Float   @map("subtotal_major_units")
  totalMajorUnits    Float   @map("total_major_units")
  customerPhone  String      @map("customer_phone")
  customerName   String?     @map("customer_name")
  paystackReference String?  @map("paystack_reference")
  paystackCheckoutUrl String? @map("paystack_checkout_url")
  paymentGateway    PaymentGateway? @map("payment_gateway")
  paidAt         DateTime?   @map("paid_at")
  cancelledAt    DateTime?   @map("cancelled_at")
  cancelReason   String?     @map("cancel_reason")
  metadata       Json?
  // Set only by the eval harness's own privileged fixture writes -- excluded from the
  // reconciliation worker's PAID-order scan so synthetic test orders (fake Paystack
  // references, no real transaction) never raise a false ReconciliationException.
  isEvalOrder    Boolean     @default(false) @map("is_eval_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [contactId], references: [id])
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  ledgerEntries CommerceLedgerEntry[]
  reconciliationExceptions ReconciliationException[]
  internalTasks InternalTask[]

  @@index([tenantId])
  @@index([tenantId, isEvalOrder])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([contactId])
  @@map("commerce_orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String? @map("product_id")

  // Price snapshot at purchase time -- never re-derive from the live Product,
  // matching InvoiceItem's snapshot shape. productId is nullable/no-cascade so
  // deleting a Product later never touches historical order line items.
  productNameSnapshot         String  @map("product_name_snapshot")
  unitPriceMajorUnitsSnapshot Float   @map("unit_price_major_units_snapshot")
  variantLabelSnapshot        String? @map("variant_label_snapshot")
  quantity          Int   @map("quantity")
  lineTotalMajorUnits Float @map("line_total_major_units")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("commerce_order_items")
}

enum OrderEventType {
  CREATED
  ITEM_ADDED
  SENT_FOR_APPROVAL
  APPROVED
  SUBMITTED_FOR_PAYMENT
  PAYMENT_INITIATED
  PAID
  FULFILLMENT_UPDATED
  CANCELLED
  REFUNDED
}

model OrderEvent {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  orderId   String         @map("order_id")
  type      OrderEventType
  data      Json?
  createdAt DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@map("commerce_order_events")
}

enum LedgerEntryType {
  GMV
  TAKE_RATE
  REFUND_ADJUSTMENT
}

model CommerceLedgerEntry {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  orderId         String          @map("order_id")
  type            LedgerEntryType
  amountMajorUnits Float          @map("amount_major_units")
  currency        String
  gateway         PaymentGateway? @map("gateway")
  gatewayEventId  String?         @map("gateway_event_id")
  data            Json
  processed       Boolean         @default(false)
  error           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The real idempotency guarantee -- a DB constraint, not just an app-level
  // check-then-write race. Stronger than BillingEvent's app-only dedupe.
  @@unique([orderId, type, gatewayEventId])
  @@index([tenantId])
  @@index([orderId])
  @@index([type])
  @@map("commerce_ledger_entries")
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

model ReconciliationException {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  orderId  String @map("order_id")
  type     String

  status ExceptionStatus @default(OPEN)
  expectedAmountMajorUnits Float? @map("expected_amount_major_units")
  actualAmountMajorUnits   Float? @map("actual_amount_major_units")
  details  Json?

  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id")
  resolutionNote String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("ResolvedExceptions", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("commerce_reconciliation_exceptions")
}

// ─── Commerce AI evaluation harness ────────────────────────────────────────
// Runs ~15-20 realistic scripted conversations through the real CommerceAiService
// (never mocked) and scores price/stock/product accuracy, order capture, payment
// handling, escalation behaviour, and response quality -- see implementation plan.
// Produces a stored, inspectable PASS/FAIL signal a human checks before enabling
// TenantSettings.commerceEnabled; does not itself gate anything automatically
// (no merchant lifecycle state machine exists yet to hook into).

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EvaluationVerdict {
  PENDING
  PASS
  FAIL
}

enum EvaluationCaseStatus {
  PASSED
  FAILED
  SKIPPED
  ERRORED
}

model EvaluationRun {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  triggeredByUserId String?             @map("triggered_by_user_id")
  status            EvaluationRunStatus @default(QUEUED)
  overallVerdict    EvaluationVerdict   @default(PENDING) @map("overall_verdict")
  // Set the instant any turn in the run is caught falsely asserting a payment
  // succeeded -- surfaced separately from the normal per-criterion pass rate so
  // it can never be diluted/averaged away in a summary view.
  criticalFailure   Boolean             @default(false) @map("critical_failure")
  scenarioCount     Int                 @map("scenario_count")
  skippedCount      Int                 @default(0) @map("skipped_count")
  criteriaSummary   Json?               @map("criteria_summary")
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  errorMessage      String?             @map("error_message")
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  triggeredByUser User?            @relation("EvaluationRunsTriggered", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  cases           EvaluationCase[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("commerce_evaluation_runs")
}

model EvaluationCase {
  id              String               @id @default(uuid())
  evaluationRunId String               @map("evaluation_run_id")
  tenantId        String               @map("tenant_id")
  scenarioKey     String               @map("scenario_key")
  criteria        String[]
  status          EvaluationCaseStatus
  contactId       String?              @map("contact_id")
  conversationId  String?              @map("conversation_id")
  orderId         String?              @map("order_id")
  // Turn-by-turn: customerMessage, aiResponse, toolTrace (name/args/result per tool call).
  transcript      Json
  // Per-criterion result, e.g. { price_accuracy: {pass, details}, response_quality: {score, judgeNotes}, ... }
  scores          Json
  failureReasons  String[]             @default([]) @map("failure_reasons")
  createdAt       DateTime             @default(now()) @map("created_at")

  run    EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([evaluationRunId])
  @@index([tenantId, createdAt])
  @@map("commerce_evaluation_cases")
}

model PromoCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  discountType  String @map("discount_type")
  discountValue Float  @map("discount_value")
  currency      String @default("USD")

  maxUses   Int? @map("max_uses")
  usedCount Int  @default(0) @map("used_count")

  validFrom  DateTime? @map("valid_from")
