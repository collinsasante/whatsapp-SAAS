# Copy to apps/backend/.env.test and point at a disposable Postgres database
# (never your dev or production DB -- e2e tests truncate tables between runs).
#
# Quick local option, reusing the dev Postgres container with a separate DB:
#   docker exec -it wa_postgres psql -U waplatform -c "CREATE DATABASE waplatform_test;"
#
# Then apply migrations once against it:
#   DATABASE_URL=postgresql://waplatform:PASSWORD@localhost:5432/waplatform_test pnpm --filter @whatsapp-platform/backend prisma:migrate

DATABASE_URL=postgresql://waplatform:CHANGE_ME@localhost:5432/waplatform_test
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET=test-jwt-refresh-secret-do-not-use-in-production

# Encrypts WhatsApp/channel connection credentials (access tokens, bot
# tokens) at rest. Optional -- when unset, credentials are read/written as
# plaintext exactly as before (CredentialsEncryptionService is a transparent
# no-op without a key), so this can be left unset indefinitely with zero
# behavior change. Must be a base64-encoded 32-byte value, e.g. generate one
# with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# IMPORTANT: do not set this in production until every reader of
# WhatsAppNumber.accessToken/Tenant.accessToken has been updated to decrypt
# (tracked in the WhatsApp multi-account channel plan, Phase 3) -- setting it
# earlier will not affect existing data, but will cause any *new* WhatsApp
# number connected in that window to have its token silently unusable by the
# not-yet-updated readers (e.g. the quality-rating sync worker).
CREDENTIALS_ENCRYPTION_KEY=
