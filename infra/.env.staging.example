# Settings for the STAGING stack only. Copy to infra/.env.staging on the server (chmod 600; it is git-ignored) and fill in.
# Use it only through infra/scripts/staging-recreate.sh, which refuses to run if these secrets match production's.
#
# Never copy a production secret here. Generate fresh values, for example:   openssl rand -hex 32

# Public address of staging (needed for Meta OAuth and webhooks, which require HTTPS)
STAGING_PUBLIC_URL=https://staging.verzchat.com:8443
VPS_IP=

# Must be different from production: tokens signed with one are accepted by the other environment's API.
JWT_SECRET=
JWT_REFRESH_SECRET=
PLATFORM_ADMIN_SETUP_SECRET=

# Database and infrastructure for the staging containers
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
WHATSAPP_WEB_INTERNAL_API_KEY=
# REQUIRED. Shared secret for backend/worker -> backend notifications and backend/worker -> realtime emits. Services refuse requests without it.
INTERNAL_SECRET=

# Your own Meta app for staging (App settings > Basic in developers.facebook.com), not a shared or third-party app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_LOGIN_CONFIG_ID=
WHATSAPP_APP_SECRET=

# Test mode only. The script aborts on a live key.
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_
# Signing secret of the Resend inbound-email webhook for the staging URL. Needed only to test inbound email; the production-mode backend refuses unsigned mail.
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=

# AI provider key. Prefer a separate key for staging so it can be revoked on its own.
DEEPSEEK_API_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# --- AI learning (privacy-gated). Leave these as they are until the privacy owner has approved the notice and retention periods. ---
# Workspaces can switch learning on only while this is exactly "true" (anything else, or missing, keeps it closed).
AI_LEARNING_OPT_IN_OPEN=false
# Platform-funded provider cost limits in USD; empty = built-in defaults (5 per workspace per month, 50 globally per month, 0.05 per run).
AI_LEARNING_WORKSPACE_MONTHLY_BUDGET_USD=
AI_LEARNING_GLOBAL_MONTHLY_BUDGET_USD=
AI_LEARNING_MAX_RESERVATION_USD=
# Automatic deletion of aged learning data. Off unless exactly "true". Periods empty = proposed defaults (90 days free text, 13 months metrics).
AI_LEARNING_RETENTION_ENABLED=false
AI_LEARNING_RETENTION_FREE_TEXT_DAYS=
AI_LEARNING_RETENTION_METRICS_MONTHS=

# --- Hybrid RAG (staging). OFF unless RAG_HYBRID_ENABLED is exactly "true". Needs the model + runtime mounts and the pgvector database image. ---
RAG_HYBRID_ENABLED=
EMBEDDING_PROVIDER=
